CONFIG_FEATURE_INSTALLER=y
CONFIG_LONG_OPTS=y
CONFIG_FEATURE_DEVPTS=y
CONFIG_FEATURE_CLEAN_UP=y
CONFIG_BUSYBOX_EXEC_PATH="/bin/busybox"

#
# Build Options
#
# The shared BusyBox launcher/libbusybox split currently trips WOS rtld
# during process startup. Keep the WOS image on the monolithic binary path
# until that loader path is fixed.
CONFIG_BUILD_LIBBUSYBOXy
CONFIG_FEATURE_SHARED_BUSYBOX=y
CONFIG_LFS=y

